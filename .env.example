# Copy file này thành `.env` rồi điền giá trị thật. KHÔNG commit file .env.

# Token Discord Bot (Developer Portal → Bot → Reset/Copy Token)
DISCORD_TOKEN=

# Application ID (Developer Portal → General Information)
CLIENT_ID=

# Application Secret (OAuth2) — dùng cho luồng invite dev (tùy chọn)
CLIENT_SECRET=

# Webhook mặc định cho lệnh spam (tùy chọn — không có sẽ tự tạo webhook trong kênh)
WEBHOOK_URL=

# Mã invite bắt buộc để qua cổng gate (tùy chọn, mặc định qUk8XTdMHv)
REQUIRED_INVITE_CODE=
